# LinkedIn — see docs/social-publishing.md for one-time app setup.
# LINKEDIN_CLIENT_ID / LINKEDIN_CLIENT_SECRET: from your LinkedIn Developer app.
# LINKEDIN_ACCESS_TOKEN / LINKEDIN_PERSON_URN / LINKEDIN_TOKEN_EXPIRES_AT:
#   written automatically by `npm run social:auth:linkedin`.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_TOKEN_EXPIRES_AT=

# Instagram / Facebook Graph API — see docs/social-publishing.md for one-time app setup.
# FACEBOOK_APP_ID / FACEBOOK_APP_SECRET: from your Meta developer app.
# INSTAGRAM_LONG_LIVED_USER_TOKEN / INSTAGRAM_ACCESS_TOKEN /
# INSTAGRAM_BUSINESS_ACCOUNT_ID / INSTAGRAM_TOKEN_EXPIRES_AT:
#   written automatically by `npm run social:auth:instagram`
#   (and refreshed by `npm run social:refresh:instagram`).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_LONG_LIVED_USER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_TOKEN_EXPIRES_AT=
